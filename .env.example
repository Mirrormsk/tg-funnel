# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# HTTPS-адрес дашборда (Telegram открывает Mini App только по HTTPS).
# Локально: любой туннель (cloudflared, ngrok…) на http://localhost:8080 → вставить выданный адрес
WEBAPP_URL=https://example.trycloudflare.com

# Telegram ID тех, кому доступен дашборд (через запятую). Пусто — дашборд закрыт для всех.
ADMIN_IDS=

# Необязательные
# DB_PATH=data/funnel.db
# CONFIG_PATH=config.yaml
# HOST=127.0.0.1
# PORT=8080
# TIMEZONE=Europe/Moscow
# DEV_MODE=false   # true — дашборд открывается в обычном браузере без проверки Telegram
